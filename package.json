{
  "name": "aeropt-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:math": "node --experimental-strip-types src/lib/math/markdownMath.selftest.ts",
    "test:practice": "node --experimental-strip-types src/lib/practiceContent.selftest.ts",
    "test:latex": "node scripts/latex-contract.test.mjs",
    "latex:audit": "node scripts/katex-audit.mjs fixtures/latex-corpus.json --max 0 --field text",
    "test:render": "node scripts/render-check.mjs fixtures/latex-agent-output.json",
    "latex:render": "node scripts/render-check.mjs fixtures/latex-corpus.json --max-stray 20",
    "typecheck": "tsc --noEmit",
    "ci": "bash ci/run.sh"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.15",
    "framer-motion": "^13.4.6",
    "katex": "0.16.47",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "0.16.47"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
